+            shuffle=train and sampler is None,
+            sampler=sampler,
+            drop_last=(
+                train and sampler is None and len(ds) > cfg.batch_size
+            ),
             num_workers=workers,
             persistent_workers=workers > 0,
         )
+
     return loaders
